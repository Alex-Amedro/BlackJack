/*C3*/SET SCHEMA PUBLIC
\u000d\u000a    drop table if exists invitation cascade 
\u000d\u000a    drop table if exists joueur cascade 
\u000d\u000a    drop table if exists match cascade 
\u000d\u000a    drop table if exists match_joueurs cascade 
\u000d\u000a    drop table if exists match_scores cascade 
\u000d\u000a    drop table if exists message cascade 
\u000d\u000a    create table invitation (\u000d\u000a        destinataire_id integer,\u000d\u000a        expediteur_id integer,\u000d\u000a        id integer generated by default as identity (start with 1),\u000d\u000a        status varchar(255),\u000d\u000a        table_id varchar(255),\u000d\u000a        primary key (id)\u000d\u000a    )
\u000d\u000a    create table joueur (\u000d\u000a        id integer generated by default as identity (start with 1),\u000d\u000a        solde integer not null,\u000d\u000a        mdp varchar(255),\u000d\u000a        pseudo varchar(255),\u000d\u000a        primary key (id)\u000d\u000a    )
\u000d\u000a    create table match (\u000d\u000a        id integer generated by default as identity (start with 1),\u000d\u000a        primary key (id)\u000d\u000a    )
\u000d\u000a    create table match_joueurs (\u000d\u000a        joueurs_id integer not null unique,\u000d\u000a        match_id integer not null\u000d\u000a    )
\u000d\u000a    create table match_scores (\u000d\u000a        joueur_id integer not null,\u000d\u000a        match_id integer not null,\u000d\u000a        score integer,\u000d\u000a        primary key (joueur_id, match_id)\u000d\u000a    )
\u000d\u000a    create table message (\u000d\u000a        auteur_id integer,\u000d\u000a        id integer generated by default as identity (start with 1),\u000d\u000a        receveur_id integer,\u000d\u000a        contenu varchar(255),\u000d\u000a        date varchar(255),\u000d\u000a        primary key (id)\u000d\u000a    )
\u000d\u000a    alter table invitation \u000d\u000a       add constraint FKc94ef7xiinyyq1o8ryfln6uae \u000d\u000a       foreign key (destinataire_id) \u000d\u000a       references joueur
\u000d\u000a    alter table invitation \u000d\u000a       add constraint FKc5tykjx29lfu0leww4ks2jh8s \u000d\u000a       foreign key (expediteur_id) \u000d\u000a       references joueur
\u000d\u000a    alter table match_joueurs \u000d\u000a       add constraint FK4jehhos2pv5iwlw91egkg981d \u000d\u000a       foreign key (joueurs_id) \u000d\u000a       references joueur
\u000d\u000a    alter table match_joueurs \u000d\u000a       add constraint FK4y4h9wuwdtf26a0jp286b8k1x \u000d\u000a       foreign key (match_id) \u000d\u000a       references match
\u000d\u000a    alter table match_scores \u000d\u000a       add constraint FKiy4igourgxpo04t2t0d74xxjp \u000d\u000a       foreign key (joueur_id) \u000d\u000a       references joueur
\u000d\u000a    alter table match_scores \u000d\u000a       add constraint FKkl71sk08cwko8k08pjc7g1lhk \u000d\u000a       foreign key (match_id) \u000d\u000a       references match
\u000d\u000a    alter table message \u000d\u000a       add constraint FK8672vofem2nth43vy65mf3s4l \u000d\u000a       foreign key (auteur_id) \u000d\u000a       references joueur
\u000d\u000a    alter table message \u000d\u000a       add constraint FKnhhredlbu28rgj5m2rgk0f6m9 \u000d\u000a       foreign key (receveur_id) \u000d\u000a       references joueur
